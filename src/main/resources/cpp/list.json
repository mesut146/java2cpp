{
  "name": "java.util.List<T>,java.util.ArrayList<T>",
  "target": "std::vector",
  "include": "CppHelper.h",
  "methods": [
    {
      "name": "add(<T>)",
      "target": "push_back($1)"
    },
    {
      "name": "add(int,<T>)",
      "target": "insert($1, $2)"
    },
    {
      "name": "addAll(java.util.Collection)",
      "target": "${varName}->insert(${varName}->end(), $1->begin(), $1->end())",
      "external": true
    },
    {
      "name": "addAll(int,java.util.Collection)",
      "target": "insert($1, $2->begin(), $2->end())"
    },
    {
      "name": "get(int)",
      "target": "at($1)"
    },
    {
      "name": "set(int,<T>)",
      "target": "(${varName}->at($1) = $2)",
      "external": true
    },
    {
      "name": "remove(int)",
      "target": "${varName}->erase(${varName}->begin() + $1)",
      "external": true
    },
    {
      "name": "remove(<T>)",
      "target": "${varName}->erase(std::find(${varName}->begin(), ${varName}->end(), $1))",
      "external": true,
      "include": "<algorithm>"
    },
    {
      "name": "indexOf(<T>)",
      "target": "std::find(${varName}->begin(), ${varName}->end(), $1) - ${varName}->begin()",
      "external": true,
      "include": "<algorithm>"
    },
    {
      "name": "size()",
      "target": "size()"
    },
    {
      "name": "isEmpty()",
      "target": "empty()"
    },
    {
      "name": "clear()",
      "target": "clear()"
    },
    {
      "name": "contains(java.lang.Object)",
      "target": "(std::find(${varName}->begin(), ${varName}->end(), $1) != ${varName}->end())",
      "external": true,
      "include": "<algorithm>"
    },
    {
      "name": "toArray()",
      "target": "CppHelper::toArray(${varName})",
      "external": true
    },
    {
      "name": "toArray(<T>[])",
      "target": "CppHelper::toArray(${varName})",
      "external": true
    }
  ]
}