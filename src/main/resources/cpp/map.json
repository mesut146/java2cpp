{
  "name": "java.util.Map<K,V>,java.util.HashMap<K,V>",
  "target": "std::unordered_map",
  "include": "<algorithm>,<unordered_map>",
  "methods": [
    {
      "name": "put(<K>,<V>)",
      "target": "insert({$1, $2})"
    },
    {
      "name": "putIfAbsent(<K>,<V>)",
      "target": "${varName}->insert({$1,$2});",
      "expr": "${varName}->at()"
    },
    {
      "name": "get(<K>)",
      "target": "at($1)"
    },
    {
      "name": "clear()",
      "target": "clear()"
    },
    {
      "name": "isEmpty()",
      "target": "empty()"
    },
    {
      "name": "size()",
      "target": "size()"
    },
    {
      "name": "remove(java.lang.Object)",
      "target": "erase($1)"
    },
    {
      "name": "keySet()",
      "target": ["std::unordered_set<K> *keys = new std::unordered_set<K>();",
                 "for(auto &a:*${varName}){",
                 "    keys->push_back(a.first);",
                 "  }"],
      "expr": "keys"
    },
    {
      "name": "containsKey(<K>)",
      "target": "(${varName}->find($1) != ${varName}->end())",
      "external": true
    },
    {
      "name": "containsValue(<V>)",
      "target": "std::any_of(${varName}->begin(), ${varName}->end(), [&](const auto &kv){ return kv.second == $1; })",
      "external": true
    },
    {
      "name": "getOrDefault(<K>,<V>)",
      "target": "(${varName}->find($1) != ${varName}->end() ? ${varName}->at($1) : $2)",
      "external": true
    }
  ]
}
